# Go
/bin/
*.test
*.out
coverage.*

# Node / Expo
node_modules/
dist/
build/
.expo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# Generated native projects. This app is CNG: `android/` and `ios/` are output
# of prebuild, and EAS silently prefers them over app.config.ts when they exist
# ("android.package is ignored because an android directory was detected"), so a
# stale one builds code the config no longer describes. Delete, never commit.
/apps/mobile/android/
/apps/mobile/ios/

# Env & secrets — never commit (.claude/rules/004-security.md)
.env
.env.*
!.env.example
*.pem

# Generated — regenerate, never hand-edit
.claude/memory/generated/
.claude/guard-warnings.log

# Card image pipeline output (large binaries; stored in object storage)
/data/card-images/

# OS / editor
.DS_Store
.idea/
*.swp
/.card-images/
/.expo-export/
