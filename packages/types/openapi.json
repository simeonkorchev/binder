            "type": "array"
          },
          "card": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScanCard"
              },
              {
                "type": "null"
              }
            ]
          },
          "outcome": {
            "description": "What happened to this scan, and so what to do with it next. Read this rather than `resolution` to decide what to show: `resolution` answers `unresolved` both when several rows matched and when none did.",
            "enum": [
              "resolved",
              "card_only",
              "ambiguous",
              "no_match"
            ],
            "type": "string"
          },
          "printing": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScanPrinting"
              },
              {
                "type": "null"
              }
            ]
          },
          "resolution": {
            "description": "How the scanned card's set was determined.",
            "enum": [
              "exact",
              "by_prefix_and_number",
              "by_number",
              "by_name",
              "unresolved"
            ],
            "type": "string"
          }
        },
        "required": [
          "outcome",
          "resolution",
          "card",
          "printing",
          "candidates"
        ],
        "type": "object"
      },
